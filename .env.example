MONGO_URI=
# MONGODB_URI= and DATABASE_URL= are also accepted in production.
JWT_SECRET=
JWT_REFRESH_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
NEWS_API_KEY=
EMAIL_USER=
EMAIL_PASS=
# Comma-separate multiple frontend origins in production, for example:
# CLIENT_URL=https://riseos.example.com,https://www.riseos.example.com
CLIENT_URL=http://127.0.0.1:5173
# Leave VITE_API_URL empty for same-origin production deployments.
# Use http://127.0.0.1:5000/api in local Vite dev, or a full API URL for split frontend/backend hosting.
VITE_API_URL=http://127.0.0.1:5000/api
PORT=5000
NODE_ENV=development
